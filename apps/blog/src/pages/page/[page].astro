---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import Pagination from '../../components/Pagination.astro'
import PostCard from '../../components/PostCard.astro'

export async function getStaticPaths() {
  const perPage = 12
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

  const totalPages = Math.ceil(posts.length / perPage)

  // Start from page 2 -- page 1 is handled by index.astro
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: {
      posts: posts.slice((i + 1) * perPage, (i + 2) * perPage),
      currentPage: i + 2,
      totalPages,
    },
  }))
}

const { posts, currentPage, totalPages } = Astro.props
---

<BaseLayout
  title={currentPage === 1 ? 'Blog' : `Blog - Page ${currentPage}`}
  description="Technical articles about web data extraction, AI agents, and building with Reader."
>
  <Header />

  <main class="flex-1 max-w-6xl mx-auto px-6 pt-32 pb-16 w-full">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">
        Reader Blog
        {currentPage > 1 && <span class="text-gray-400 font-normal"> - Page {currentPage}</span>}
      </h1>
      <p class="text-gray-500 text-lg">
        Guides, tutorials, and deep dives on web scraping, AI agents, and building with Reader.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>

    <Pagination currentPage={currentPage} totalPages={totalPages} />
  </main>

  <Footer />
</BaseLayout>
