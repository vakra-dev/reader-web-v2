---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import PostCard from '../../components/PostCard.astro'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft)

  const authorMap = new Map<string, { name: string; posts: typeof posts }>()

  for (const post of posts) {
    const slug = post.data.author.toLowerCase().replace(/\s+/g, '-')
    if (!authorMap.has(slug)) {
      authorMap.set(slug, { name: post.data.author, posts: [] })
    }
    authorMap.get(slug)!.posts.push(post)
  }

  return Array.from(authorMap.entries()).map(([slug, data]) => ({
    params: { author: slug },
    props: {
      authorName: data.name,
      posts: data.posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }))
}

const { authorName, posts } = Astro.props

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: authorName,
  url: Astro.url.toString(),
}
const safeJsonLd = JSON.stringify(personSchema).replace(/</g, '\\u003c')
---

<BaseLayout
  title={`Articles by ${authorName}`}
  description={`All blog posts written by ${authorName} on the Reader blog.`}
>
  <script type="application/ld+json" set:html={safeJsonLd} />

  <Header />

  <main class="flex-1 max-w-6xl mx-auto px-6 pt-32 pb-16 w-full">
    <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-gray-900 transition-colors">Reader</a></li>
        <li><span class="mx-1">/</span></li>
        <li><a href="/blog" class="hover:text-gray-900 transition-colors">Blog</a></li>
        <li><span class="mx-1">/</span></li>
        <li class="text-gray-900">{authorName}</li>
      </ol>
    </nav>

    <div class="mb-12">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">{authorName}</h1>
      <p class="text-sm text-gray-500">{posts.length} article{posts.length !== 1 ? 's' : ''}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>
