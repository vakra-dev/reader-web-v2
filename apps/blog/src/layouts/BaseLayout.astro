---
import '@fontsource-variable/inter';

interface Props {
  title: string
  description: string
  image?: string
  type?: 'website' | 'article'
  publishedTime?: Date
  modifiedTime?: Date
  author?: string
}

const {
  title,
  description,
  image = 'https://reader.dev/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = image.startsWith('http') ? image : new URL(image, Astro.site)
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Primary Meta Tags -->
    <title>{title} | Reader</title>
    <meta name="title" content={`${title} | Reader`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Reader" />

    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === 'article' && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Reader Blog RSS"
      href={new URL('/blog/rss.xml', Astro.site)}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900 antialiased font-sans">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Inter Variable', system-ui, sans-serif;
  }

  body {
    font-family: var(--font-sans);
  }
</style>
