---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, date, updated, author, authorRole, image } = post.data

// Calculate reading time
const content = post.body
const words = content.split(/\s+/).length
const readingTime = Math.ceil(words / 200)

// JSON-LD structured data - with XSS protection
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: image ? new URL(image, Astro.site).toString() : undefined,
  datePublished: date.toISOString(),
  dateModified: (updated || date).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    jobTitle: authorRole,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Reader',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.toString(),
  },
}

// Escape < to prevent XSS via </script> injection
const safeJsonLd = JSON.stringify(articleSchema).replace(/</g, '\\u003c')

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  author={author}
>
  <script type="application/ld+json" set:html={safeJsonLd} />

  <Header />

  <main class="flex-1 max-w-2xl mx-auto px-4 pt-32 pb-16 w-full">
    <article>
      <header class="mb-10">
        <h1 class="text-3xl font-bold text-gray-900 mb-4">
          {title}
        </h1>

        <div class="flex items-center gap-4 text-sm text-gray-500">
          <span>{author}</span>
          <span>&middot;</span>
          <time datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
          <span>&middot;</span>
          <span>{readingTime} min read</span>
        </div>

        {updated && updated > date && (
          <p class="text-sm text-gray-500 mt-2">
            Updated on {formatDate(updated)}
          </p>
        )}
      </header>

      <div class="prose prose-gray prose-lg max-w-none">
        <slot />
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
