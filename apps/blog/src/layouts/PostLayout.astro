---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import TableOfContents from '../components/TableOfContents.astro'
import RelatedPosts from '../components/RelatedPosts.astro'
import type { CollectionEntry } from 'astro:content'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  post: CollectionEntry<'blog'>
  headings: Heading[]
  allPosts: CollectionEntry<'blog'>[]
}

const { post, headings, allPosts } = Astro.props
const { title, description, date, updated, author, authorRole, authorImage, image, category, keywords, schemaType, faq } = post.data
const ogImage = image || `/blog/og/${post.id}.png`

// Calculate reading time
const content = post.body || ''
const words = content.split(/\s+/).filter(Boolean).length
const readingTime = Math.max(1, Math.ceil(words / 275))

// Article JSON-LD
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: image ? new URL(image, Astro.site).toString() : new URL(ogImage, Astro.site).toString(),
  datePublished: date.toISOString(),
  dateModified: (updated || date).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    ...(authorRole && { jobTitle: authorRole }),
    ...(authorImage && { image: authorImage }),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Reader',
    url: 'https://reader.dev',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.id}/`, Astro.site).toString(),
  },
  wordCount: words,
  ...(keywords && { keywords: keywords.join(', ') }),
  ...(category && { articleSection: category }),
}

// BreadcrumbList JSON-LD
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Reader',
      item: 'https://reader.dev',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://reader.dev/blog',
    },
    ...(category ? [{
      '@type': 'ListItem',
      position: 3,
      name: category,
      item: `https://reader.dev/blog/category/${category.toLowerCase().replace(/\s+/g, '-')}`,
    }] : []),
    {
      '@type': 'ListItem',
      position: category ? 4 : 3,
      name: title,
    },
  ],
}

// HowTo schema for tutorial posts (generates step-by-step rich results)
const howToSchema = schemaType === 'howto' ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description: description,
  step: headings
    .filter((h) => h.depth === 2)
    .map((h, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: h.text,
      url: `${new URL(`/blog/${post.id}/`, Astro.site).toString()}#${h.slug}`,
    })),
} : null

// FAQPage schema (deprecated for SERP display but 3.2x more AI Overview citations)
const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null

// Combine all schemas
const schemas = [articleSchema, breadcrumbSchema, howToSchema, faqSchema].filter(Boolean)

// Escape < to prevent XSS via </script> injection
const safeJsonLd = JSON.stringify(schemas).replace(/</g, '\\u003c')

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}

// Category slug helper
const categorySlug = category ? category.toLowerCase().replace(/\s+/g, '-') : null
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  author={author}
>
  <script type="application/ld+json" set:html={safeJsonLd} />

  <Header />

  <div class="flex-1 pt-32 pb-16">
    <div class="max-w-6xl mx-auto px-6 flex gap-12">
      {/* Main content */}
      <main class="min-w-0 flex-1 max-w-3xl">
        <article data-pagefind-body>
          {/* Breadcrumbs */}
          <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
            <ol class="flex items-center gap-1.5">
              <li><a href="/" class="hover:text-gray-900 transition-colors">Reader</a></li>
              <li><span class="mx-1">/</span></li>
              <li><a href="/blog" class="hover:text-gray-900 transition-colors">Blog</a></li>
              {category && (
                <>
                  <li><span class="mx-1">/</span></li>
                  <li>
                    <a href={`/blog/category/${categorySlug}`} class="hover:text-gray-900 transition-colors">
                      {category}
                    </a>
                  </li>
                </>
              )}
            </ol>
          </nav>

          <header class="mb-10">
            <h1 class="text-3xl font-bold text-gray-900 mb-4">
              {title}
            </h1>

            <div class="flex items-center gap-4 text-sm text-gray-500">
              <a href={`/blog/author/${author.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-gray-900 transition-colors">
                {author}
              </a>
              <span>&middot;</span>
              <time datetime={date.toISOString()}>
                {formatDate(date)}
              </time>
              <span>&middot;</span>
              <span>{readingTime} min read</span>
            </div>

            {updated && updated > date && (
              <p class="text-sm text-gray-500 mt-2">
                Updated on {formatDate(updated)}
              </p>
            )}
          </header>

          <div class="prose prose-gray prose-lg max-w-none">
            <slot />
          </div>

          {/* FAQ Section */}
          {faq && faq.length > 0 && (
            <section class="mt-12 pt-8 border-t border-gray-200">
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions</h2>
              <dl class="space-y-6">
                {faq.map((item) => (
                  <div>
                    <dt class="text-lg font-semibold text-gray-900 mb-2">{item.question}</dt>
                    <dd class="text-gray-600 leading-relaxed">{item.answer}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          {/* Tags */}
          {keywords && keywords.length > 0 && (
            <div class="mt-10 pt-6 border-t border-gray-200">
              <div class="flex flex-wrap gap-2">
                {keywords.map((keyword) => (
                  <span class="px-3 py-1 text-xs font-medium text-gray-600 bg-gray-100 rounded-full">
                    {keyword}
                  </span>
                ))}
              </div>
            </div>
          )}
        </article>

        <RelatedPosts currentPost={post} allPosts={allPosts} />
      </main>

      {/* Right sidebar - TOC + CTA, hidden on mobile */}
      <aside class="hidden lg:block w-60 shrink-0">
        <div class="sticky top-28">
          <TableOfContents headings={headings} />

          {/* CTA Card */}
          <div class="mt-8 p-5 bg-gray-50 rounded-lg border border-gray-200">
            <p class="text-sm font-semibold text-gray-900 mb-2">Scrape any web page</p>
            <p class="text-xs text-gray-500 mb-4">Clean markdown from any URL. One API call. No infrastructure to manage.</p>
            <a
              href="https://docs.reader.dev"
              class="block w-full text-center px-4 py-2 bg-[#0D9373] text-white text-sm font-medium rounded-lg hover:bg-[#0a7d62] transition-colors"
            >
              Get Started
            </a>
            <a
              href="https://github.com/vakra-dev/reader"
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center px-4 py-2 mt-2 border border-gray-200 text-gray-600 text-sm font-medium rounded-lg hover:border-gray-300 hover:text-gray-900 transition-colors"
            >
              View on GitHub
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <Footer />
</BaseLayout>
