---
// Keep in sync with: apps/web/components/layout/footer.tsx
---

<footer class="border-t border-neutral-200 py-12">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-4">
        <img
          src="/text_logo.png"
          alt="Reader"
          width="100"
          height="33"
          class="h-8 w-auto"
        />
        <span class="text-neutral-500 text-sm">
          Open-source web scraping for LLMs
        </span>
      </div>

      <div class="flex items-center gap-6">
        <a
          href="https://docs.reader.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-neutral-600 hover:text-neutral-900 transition-colors"
        >
          Docs
        </a>
        <a
          href="https://github.com/vakra-dev/reader"
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-600 hover:text-neutral-900 transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-neutral-200 text-center text-sm text-neutral-500">
      <p>Apache 2.0 License</p>
    </div>
  </div>
</footer>
