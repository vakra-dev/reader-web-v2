    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 border-t border-neutral-200 flex justify-end">
      <div class="flex items-center gap-4">
        <a href="https://github.com/vakra-dev/reader" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">GitHub</a>
        <a href="https://discord.gg/6tjkq7J5WV" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Discord</a>
      </div>
    </div>
