          <li><a href="/blog/scrape-google" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Scrape Google</a></li>
          <li><a href="/blog/scrape-google-maps" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Scrape Google Maps</a></li>
          <li><a href="/blog/bypass-cloudflare" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Cloudflare Bypass</a></li>
          <li><a href="/blog/anti-bot-detection" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Anti-Bot Detection</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold text-neutral-700 mb-3">Resources</h3>
        <ul class="space-y-2">
          <li><a href="https://docs.reader.dev" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Documentation</a></li>
          <li><a href="/blog" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Blog</a></li>
          <li><a href="https://github.com/vakra-dev/reader" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">GitHub</a></li>
          <li><a href="/open-source" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Open Source</a></li>
        </ul>

        <h3 class="text-sm font-semibold text-neutral-700 mb-3 mt-6">Community</h3>
        <ul class="space-y-2">
          <li><a href="https://discord.gg/6tjkq7J5WV" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Discord</a></li>
        </ul>
