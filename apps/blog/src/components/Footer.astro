---
// Keep in sync with: apps/web/components/layout/footer.tsx
---

<footer class="border-t border-neutral-200 mt-auto">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8">
      <!-- Logo column -->
      <div class="col-span-2 md:col-span-1">
        <img
          src="/blog/text_logo.png"
          alt="Reader"
          width="90"
          height="30"
          class="mb-4 opacity-70"
        />
        <p class="text-sm text-neutral-500 leading-relaxed">
          AI web infrastructure platform
        </p>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-sm font-semibold text-neutral-700 mb-3">Product</h3>
        <ul class="space-y-2">
          <li><a href="/scrape" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Scrape</a></li>
          <li><a href="/crawl" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Crawl</a></li>
          <li><a href="/browser" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Browser</a></li>
          <li><a href="/extract" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Extract</a></li>
          <li><a href="/markdown" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Markdown Tool</a></li>
        </ul>
      </div>

      <!-- Solutions -->
      <div>
        <h3 class="text-sm font-semibold text-neutral-700 mb-3">Solutions</h3>
        <ul class="space-y-2">
          <li><a href="/solutions/ecommerce" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">E-commerce</a></li>
          <li><a href="/solutions/real-estate" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Real Estate</a></li>
          <li><a href="/solutions/lead-research" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Lead Research</a></li>
          <li><a href="/solutions/price-monitoring" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Price Monitoring</a></li>
          <li><a href="/solutions/competitive-intelligence" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">Competitive Intelligence</a></li>
          <li><a href="/solutions/rag-pipelines" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">RAG Pipelines</a></li>
          <li><a href="/solutions/ai-agents" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">AI Agents</a></li>
          <li><a href="/solutions/llm-dataset-collection" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">LLM Dataset Collection</a></li>
        </ul>
      </div>

      <!-- Compare -->
      <div>
        <h3 class="text-sm font-semibold text-neutral-700 mb-3">Compare</h3>
        <ul class="space-y-2">
          <li><a href="/compare/firecrawl" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">vs Firecrawl</a></li>
          <li><a href="/compare/scrapingbee" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">vs ScrapingBee</a></li>
          <li><a href="/compare/zenrows" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">vs ZenRows</a></li>
          <li><a href="/compare/browserbase" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">vs Browserbase</a></li>
          <li><a href="/compare/apify" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">vs Apify</a></li>
          <li><a href="/compare/bright-data" class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">vs Bright Data</a></li>
        </ul>
      </div>

