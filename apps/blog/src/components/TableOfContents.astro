---
interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3)
---

{filtered.length > 2 && (
  <nav aria-label="Table of contents">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">
      On this page
    </p>
    <ul class="space-y-2 border-l border-gray-200">
      {filtered.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class:list={[
              "block border-l-2 -ml-px transition-colors hover:text-gray-900 hover:border-gray-900",
              heading.depth === 2
                ? "text-[13px] text-gray-600 border-transparent pl-3 font-medium"
                : "text-[12px] text-gray-400 border-transparent pl-6",
            ]}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
