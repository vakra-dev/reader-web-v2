---
// Keep in sync with: apps/web/components/Header.tsx
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-neutral-200 bg-white">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center">
