---
// Keep in sync with: apps/web/components/layout/header.tsx
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-neutral-200 bg-white/80 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img
        src="/blog/text_logo.png"
        alt="Reader"
        width="110"
        height="36"
        class="h-9 w-auto"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      <!-- Solutions dropdown -->
      <div class="relative" data-dropdown="solutions">
        <button
          class="px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900 transition-colors flex items-center gap-1"
          data-dropdown-trigger
        >
          Solutions
          <svg class="w-3.5 h-3.5 transition-transform duration-150" data-dropdown-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="absolute top-full left-0 mt-1 w-52 py-2 bg-white border border-neutral-200 rounded-md shadow-lg z-50 hidden" data-dropdown-menu>
          <a href="/solutions/ecommerce" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">E-commerce</a>
          <a href="/solutions/real-estate" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">Real Estate</a>
          <a href="/solutions/lead-generation" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">Lead Generation</a>
          <a href="/solutions/price-monitoring" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">Price Monitoring</a>
          <a href="/solutions/competitive-intelligence" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">Competitive Intelligence</a>
          <a href="/solutions/rag-pipelines" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">RAG Pipelines</a>
          <a href="/solutions/ai-agents" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">AI Agents</a>
          <a href="/solutions/llm-training-data" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">LLM Training Data</a>
        </div>
      </div>

      <!-- Compare dropdown -->
      <div class="relative" data-dropdown="compare">
        <button
          class="px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900 transition-colors flex items-center gap-1"
          data-dropdown-trigger
        >
          Compare
          <svg class="w-3.5 h-3.5 transition-transform duration-150" data-dropdown-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="absolute top-full left-0 mt-1 w-52 py-2 bg-white border border-neutral-200 rounded-md shadow-lg z-50 hidden" data-dropdown-menu>
          <a href="/compare/firecrawl" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">vs Firecrawl</a>
          <a href="/compare/scrapingbee" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">vs ScrapingBee</a>
          <a href="/compare/zenrows" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">vs ZenRows</a>
          <a href="/compare/browserbase" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">vs Browserbase</a>
          <a href="/compare/apify" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">vs Apify</a>
          <a href="/compare/bright-data" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">vs Bright Data</a>
        </div>
      </div>

      <!-- Resources dropdown -->
      <div class="relative" data-dropdown="resources">
        <button
          class="px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900 transition-colors flex items-center gap-1"
          data-dropdown-trigger
        >
          Resources
          <svg class="w-3.5 h-3.5 transition-transform duration-150" data-dropdown-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="absolute top-full left-0 mt-1 w-52 py-2 bg-white border border-neutral-200 rounded-md shadow-lg z-50 hidden" data-dropdown-menu>
          <a href="/blog" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">Blog</a>
          <a href="/open-source" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">Open Source</a>
          <a href="/markdown" class="block px-4 py-2 text-sm text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors">Markdown Tool</a>
        </div>
      </div>

      <a
        href="https://docs.reader.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900 transition-colors"
      >
        Docs
      </a>

      <div class="w-px h-4 bg-neutral-200 mx-2"></div>

      <a
        href="https://github.com/vakra-dev/reader"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 text-neutral-600 hover:text-neutral-900 transition-colors"
        aria-label="GitHub"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
      </a>

      <a
        href="https://console.reader.dev"
        class="ml-1 px-4 py-1.5 text-sm font-medium rounded-md bg-[#0D9373] text-white hover:bg-[#0B7D63] transition-colors"
      >
        Get Started
      </a>
    </nav>

    <!-- Mobile toggle -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden p-2 text-neutral-600"
      aria-label="Toggle menu"
    >
      <svg class="w-5 h-5" id="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg class="w-5 h-5 hidden" id="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden border-t border-neutral-200 bg-white max-h-[80vh] overflow-y-auto hidden">
    <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-1">
      <div class="px-3 py-1.5"><span class="text-xs font-semibold text-neutral-400 uppercase tracking-wider">Solutions</span></div>
      <a href="/solutions/ecommerce" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">E-commerce</a>
      <a href="/solutions/real-estate" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">Real Estate</a>
      <a href="/solutions/lead-generation" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">Lead Generation</a>
      <a href="/solutions/price-monitoring" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">Price Monitoring</a>
      <a href="/solutions/competitive-intelligence" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">Competitive Intelligence</a>
      <a href="/solutions/rag-pipelines" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">RAG Pipelines</a>
      <a href="/solutions/ai-agents" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">AI Agents</a>
      <a href="/solutions/llm-training-data" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">LLM Training Data</a>
      <div class="my-1 border-t border-neutral-100"></div>
      <div class="px-3 py-1.5"><span class="text-xs font-semibold text-neutral-400 uppercase tracking-wider">Compare</span></div>
      <a href="/compare/firecrawl" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">vs Firecrawl</a>
      <a href="/compare/scrapingbee" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">vs ScrapingBee</a>
      <a href="/compare/zenrows" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">vs ZenRows</a>
      <a href="/compare/browserbase" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">vs Browserbase</a>
      <a href="/compare/apify" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">vs Apify</a>
      <a href="/compare/bright-data" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">vs Bright Data</a>
      <div class="my-1 border-t border-neutral-100"></div>
      <div class="px-3 py-1.5"><span class="text-xs font-semibold text-neutral-400 uppercase tracking-wider">Resources</span></div>
      <a href="/blog" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">Blog</a>
      <a href="/open-source" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">Open Source</a>
      <a href="/markdown" class="pl-6 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">Markdown Tool</a>
      <a href="https://docs.reader.dev" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">Docs</a>
      <div class="my-2 border-t border-neutral-200"></div>
      <a href="https://github.com/vakra-dev/reader" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-1.5 text-sm text-neutral-600 hover:text-neutral-900">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        GitHub
      </a>
      <a href="https://console.reader.dev" class="mt-2 px-4 py-2 bg-[#0D9373] text-white text-sm font-medium rounded-md text-center hover:bg-[#0B7D63] transition-colors">Get Started</a>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    // Mobile menu toggle
    var toggle = document.getElementById('mobile-menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var menuIcon = document.getElementById('menu-icon');
    var closeIcon = document.getElementById('close-icon');

    if (toggle && menu) {
      toggle.addEventListener('click', function() {
        menu.classList.toggle('hidden');
        menuIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      });
    }

    // Desktop dropdowns
    document.querySelectorAll('[data-dropdown]').forEach(function(dropdown) {
      var trigger = dropdown.querySelector('[data-dropdown-trigger]');
      var menuEl = dropdown.querySelector('[data-dropdown-menu]');
      var chevron = dropdown.querySelector('[data-dropdown-chevron]');

      if (trigger && menuEl) {
        trigger.addEventListener('click', function(e) {
          e.stopPropagation();
          document.querySelectorAll('[data-dropdown-menu]').forEach(function(m) {
            if (m !== menuEl) {
              m.classList.add('hidden');
              m.closest('[data-dropdown]').querySelector('[data-dropdown-chevron]').style.transform = '';
            }
          });
          var isOpen = !menuEl.classList.contains('hidden');
          menuEl.classList.toggle('hidden');
          chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        });
      }
    });

    document.addEventListener('click', function() {
      document.querySelectorAll('[data-dropdown-menu]').forEach(function(m) {
        m.classList.add('hidden');
        m.closest('[data-dropdown]').querySelector('[data-dropdown-chevron]').style.transform = '';
      });
    });
  })();
</script>
