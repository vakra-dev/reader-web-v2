---
import type { CollectionEntry } from 'astro:content'

interface Props {
  currentPost: CollectionEntry<'blog'>
  allPosts: CollectionEntry<'blog'>[]
}

const { currentPost, allPosts } = Astro.props

// Find related posts by tag overlap + same category
const currentKeywords = currentPost.data.keywords || []
const currentCategory = currentPost.data.category

const related = allPosts
  .filter((p) => p.id !== currentPost.id)
  .map((p) => {
    const postKeywords = p.data.keywords || []
    const tagOverlap = postKeywords.filter((k) => currentKeywords.includes(k)).length
    const categoryMatch = p.data.category === currentCategory ? 2 : 0
    return { post: p, score: tagOverlap + categoryMatch }
  })
  .filter((p) => p.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 3)
  .map((p) => p.post)

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

{related.length > 0 && (
  <section class="mt-12 pt-8 border-t border-gray-200">
    <h2 class="text-lg font-semibold text-gray-900 mb-6">Related Articles</h2>
    <div class="space-y-6">
      {related.map((post) => (
        <a href={`/blog/${post.id}/`} class="block group">
          <h3 class="text-base font-medium text-gray-900 group-hover:text-black">
            {post.data.title}
          </h3>
          <div class="flex items-center gap-3 text-sm text-gray-500 mt-1">
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            {post.data.category && (
              <>
                <span>&middot;</span>
                <span>{post.data.category}</span>
              </>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
)}
