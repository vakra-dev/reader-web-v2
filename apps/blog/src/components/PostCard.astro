---
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, date, author, category } = post.data

const words = (post.body || '').split(/\s+/).filter(Boolean).length
const readingTime = Math.max(1, Math.ceil(words / 275))

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

<article class="group">
  <a href={`/blog/${post.id}/`} class="block h-full border border-gray-200 rounded-lg overflow-hidden hover:border-gray-300 hover:shadow-sm transition-all">
    <div class="p-5 flex flex-col h-full">
      {category && (
        <span class="text-xs font-medium text-emerald-700 mb-2">{category}</span>
      )}

      <h2 class="text-lg font-bold text-gray-900 group-hover:text-black mb-2 line-clamp-2">
        {title}
      </h2>

      <p class="text-sm text-gray-500 leading-relaxed mb-4 line-clamp-3 flex-1">
        {description}
      </p>

      <div class="flex items-center gap-3 text-xs text-gray-400 pt-3 border-t border-gray-100">
        <span class="font-medium text-gray-600">{author}</span>
        <span>&middot;</span>
        <time datetime={date.toISOString()}>
          {formatDate(date)}
        </time>
        <span>&middot;</span>
        <span>{readingTime} min read</span>
      </div>
    </div>
  </a>
</article>
